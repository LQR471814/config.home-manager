\ProvidesPackage{myconfig}

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{titlesec}
\RequirePackage{graphicx}
\RequirePackage{caption}
\RequirePackage{xurl}  % Allow hyperlinks to be broken at any character
\RequirePackage[colorlinks=true, urlcolor=blue]{hyperref}
\hypersetup{
	colorlinks=true,
	linkcolor=blue,      % Color of internal links (sections, pages)
	citecolor=blue,      % Color of bibliographical citations
	filecolor=blue,      % Color of file links
	urlcolor=blue,       % Color of external hyperlinks
}

\setlength{\parindent}{0pt}
\setlength{\parskip}{1em}

\titlespacing*{\section}{0pt}{0pt}{0pt} % {left}{before}{after}
\titlespacing*{\subsection}{0pt}{0pt}{0pt}
\titlespacing*{\subsubsection}{0pt}{0pt}{0pt}

\newcommand{\stdbox}[1]{
	\fbox{
		\parbox{0.9\textwidth}{#1}
	}
}
